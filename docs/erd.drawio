<mxCell id="c651" value="&lt;b&gt;PK&lt;/b&gt; primary key (bold, underlined)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; foreign key (italic)&lt;br&gt;&lt;b&gt;UK&lt;/b&gt; unique natural key&lt;br&gt;&lt;b&gt;PK,FK&lt;/b&gt; part of a composite key&lt;br&gt;&lt;br&gt;&lt;i&gt;Relationship name&lt;/i&gt; reads parent → child, e.g. &lt;i&gt;riders rides sessions&lt;/i&gt;." style="text;html=1;fontFamily=Arial;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2594" y="396.0" width="306" height="150" as="geometry"/></mxCell>
